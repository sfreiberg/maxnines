[Unit]
Description=MaxNines monitoring agent
Documentation=https://github.com/sfreiberg/maxnines
Wants=network-online.target
After=network-online.target

[Service]
# Started as root, it becomes the maxnines user before it connects to anything,
# and leaves a small helper as root for the built-in actions that need it.
# NoNewPrivileges isn't set here, as it would stop actions using sudo. Its
# folder for
# its key, its last config and samples waiting to be sent is made by the package,
# as systemd would hand a folder it made to root.
ExecStart=/usr/bin/maxnines-agent --config /etc/maxnines/agent.hcl
WorkingDirectory=-/var/lib/maxnines-agent
Restart=on-failure
RestartSec=5
# It only reads the machine, apart from its own folder. Custom metric commands and
# actions run with these limits too.
ProtectSystem=full
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
