[Unit]
Description=MaxNines monitoring server
Documentation=https://github.com/sfreiberg/maxnines
Wants=network-online.target
After=network-online.target

[Service]
User=maxnines
Group=maxnines
ExecStart=/usr/bin/maxnines-server --config /etc/maxnines/server.hcl
# Its databases live here, and it writes nowhere else.
StateDirectory=maxnines-server
StateDirectoryMode=0750
WorkingDirectory=/var/lib/maxnines-server
Restart=on-failure
RestartSec=5
# Lets it listen on 80 or 443, for automatic certificates.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
