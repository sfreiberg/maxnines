#!/bin/sh
# The config isn't one of the package's files, so upgrading never changes it or
# asks about it. The default is copied in only when there's no config yet, and as
# the config can hold secrets, only root and the service can read it.
set -e
if [ "$1" = "configure" ] && [ ! -e /etc/maxnines/server.hcl ]; then
  install -d -m 0755 /etc/maxnines
  install -m 0640 -o root -g maxnines /usr/share/maxnines/server.hcl /etc/maxnines/server.hcl
fi
#DEBHELPER#
