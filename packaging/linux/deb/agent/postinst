#!/bin/sh
# The config isn't one of the package's files, so upgrading never changes it or
# asks about it. The default is copied in only when there's no config yet, and as
# the config can hold secrets, only root and the service can read it.
set -e
if [ "$1" = "configure" ] && [ ! -e /etc/maxnines/agent.hcl ]; then
  install -d -m 0755 /etc/maxnines
  install -m 0640 -o root -g maxnines /usr/share/maxnines/agent.hcl /etc/maxnines/agent.hcl
fi
# Where it keeps its key and what it hasn't sent yet. The agent's own user owns it.
if [ "$1" = "configure" ] && [ ! -e /var/lib/maxnines-agent ]; then
  install -d -m 0750 -o maxnines -g maxnines /var/lib/maxnines-agent
fi
#DEBHELPER#
